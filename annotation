<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Visual Analysis Studio</title>
  <style>
    :root {
      --bg: #f7f3ee;
      --panel: #ffffff;
      --ink: #2f2a27;
      --muted: #6f6760;
      --accent: #9f3f35;
      --accent-dark: #762d27;
      --line: #ded4ca;
      --soft: #efe6dc;
      --shadow: 0 18px 50px rgba(47, 42, 39, 0.12);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      background: linear-gradient(135deg, #f7f3ee 0%, #ede1d5 100%);
      color: var(--ink);
      min-height: 100vh;
    }

    .app {
      width: min(1180px, 94vw);
      margin: 0 auto;
      padding: 32px 0 48px;
    }

    header {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 28px;
      box-shadow: var(--shadow);
      padding: 28px;
      margin-bottom: 22px;
    }

    .eyebrow {
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-family: Arial, sans-serif;
      font-size: 0.75rem;
      color: var(--accent);
      font-weight: 700;
      margin-bottom: 8px;
    }

    h1 {
      margin: 0 0 12px;
      font-size: clamp(2rem, 4vw, 3.5rem);
      line-height: 1;
    }

    .directions {
      max-width: 850px;
      font-size: 1.12rem;
      line-height: 1.55;
      color: var(--muted);
      margin: 0;
    }

    .directions strong {
      color: var(--ink);
    }

    .layout {
      display: grid;
      grid-template-columns: minmax(0, 1.45fr) minmax(320px, 0.85fr);
      gap: 22px;
      align-items: start;
    }

    .card {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 28px;
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
      padding: 18px;
      border-bottom: 1px solid var(--line);
      background: #fffaf6;
    }

    button,
    .file-label {
      border: 0;
      border-radius: 999px;
      background: var(--accent);
      color: white;
      font-family: Arial, sans-serif;
      font-size: 0.92rem;
      font-weight: 700;
      padding: 11px 16px;
      cursor: pointer;
      transition: transform 0.15s ease, background 0.15s ease;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    button:hover,
    .file-label:hover {
      background: var(--accent-dark);
      transform: translateY(-1px);
    }

    button.secondary {
      background: var(--soft);
      color: var(--ink);
    }

    button.secondary:hover {
      background: #e3d6ca;
    }

    button:disabled {
      cursor: not-allowed;
      opacity: 0.45;
      transform: none;
    }

    input[type="file"] {
      display: none;
    }

    .counter {
      margin-left: auto;
      font-family: Arial, sans-serif;
      color: var(--muted);
      font-size: 0.92rem;
      font-weight: 700;
    }

    .stage-wrap {
      padding: 18px;
    }

    .stage {
      position: relative;
      width: 100%;
      min-height: 460px;
      border: 2px dashed #cdbfb2;
      border-radius: 22px;
      background:
        radial-gradient(circle at 20% 20%, rgba(159, 63, 53, 0.08), transparent 26%),
        linear-gradient(135deg, #fbf8f4, #f1e7dd);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      cursor: crosshair;
    }

    .placeholder {
      max-width: 460px;
      text-align: center;
      color: var(--muted);
      padding: 32px;
      font-family: Arial, sans-serif;
      line-height: 1.55;
    }

    .placeholder strong {
      color: var(--ink);
      display: block;
      font-size: 1.2rem;
      margin-bottom: 8px;
      font-family: Georgia, "Times New Roman", serif;
    }

    #analysisImage {
      max-width: 100%;
      max-height: 75vh;
      display: none;
      user-select: none;
    }

    .pin {
      position: absolute;
      width: 34px;
      height: 34px;
      transform: translate(-50%, -50%);
      border-radius: 50%;
      background: var(--accent);
      color: white;
      font-family: Arial, sans-serif;
      font-weight: 800;
      display: grid;
      place-items: center;
      border: 3px solid white;
      box-shadow: 0 8px 18px rgba(0, 0, 0, 0.24);
      pointer-events: none;
    }

    .side {
      padding: 22px;
    }

    .side h2 {
      margin: 0 0 8px;
      font-size: 1.5rem;
    }

    .hint {
      margin: 0 0 18px;
      color: var(--muted);
      font-family: Arial, sans-serif;
      line-height: 1.45;
      font-size: 0.94rem;
    }

    .annotation-list {
      display: grid;
      gap: 14px;
    }

    .annotation {
      border: 1px solid var(--line);
      background: #fffaf6;
      border-radius: 20px;
      padding: 14px;
    }

    .annotation label {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-family: Arial, sans-serif;
      color: var(--ink);
      font-weight: 800;
      margin-bottom: 8px;
    }

    .annotation label span {
      background: var(--accent);
      color: white;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      display: inline-grid;
      place-items: center;
      margin-right: 8px;
    }

    .annotation small {
      color: var(--muted);
      font-weight: 600;
    }

    textarea {
      width: 100%;
      min-height: 92px;
      border: 1px solid #d8ccc0;
      border-radius: 14px;
      padding: 12px;
      resize: vertical;
      font: 0.96rem/1.45 Arial, sans-serif;
      color: var(--ink);
      background: white;
    }

    textarea:focus {
      outline: 3px solid rgba(159, 63, 53, 0.18);
      border-color: var(--accent);
    }

    .reflection {
      margin-top: 18px;
      border-top: 1px solid var(--line);
      padding-top: 18px;
    }

    .reflection label {
      display: block;
      font-family: Arial, sans-serif;
      font-weight: 800;
      margin-bottom: 8px;
    }

    .reflection textarea {
      min-height: 130px;
    }

    .export-box {
      margin-top: 18px;
      background: #f7f0e9;
      border: 1px solid var(--line);
      border-radius: 20px;
      padding: 14px;
      font-family: Arial, sans-serif;
      color: var(--muted);
      line-height: 1.45;
      font-size: 0.92rem;
    }

    .empty-state {
      padding: 18px;
      border: 1px dashed #cdbfb2;
      border-radius: 18px;
      color: var(--muted);
      background: #fffaf6;
      font-family: Arial, sans-serif;
      line-height: 1.45;
    }

    @media (max-width: 900px) {
      .layout {
        grid-template-columns: 1fr;
      }

      .counter {
        width: 100%;
        margin-left: 0;
      }
    }

    @media print {
      body {
        background: white;
      }

      .toolbar,
      .export-box,
      button,
      .file-label {
        display: none !important;
      }

      .app {
        width: 100%;
        padding: 0;
      }

      header,
      .card {
        box-shadow: none;
      }

      .layout {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <main class="app">
    <header>
      <div class="eyebrow">Children’s Literature • Visual Reading Tool</div>
      <h1>Visual Analysis Studio</h1>
      <p class="directions">
        <strong>Directions:</strong> Annotate 3–5 elements of this panel and explain how they shape meaning. Upload an image or use the sample image, click directly on important details, and write a short note for each annotation.
      </p>
    </header>

    <section class="layout">
      <div class="card">
        <div class="toolbar">
          <label class="file-label" for="imageUpload">Upload Image</label>
          <input id="imageUpload" type="file" accept="image/*" />
          <button id="sampleButton" type="button" class="secondary">Use Sample Image</button>
          <button id="undoButton" type="button" class="secondary" disabled>Undo Last Pin</button>
          <button id="clearButton" type="button" class="secondary" disabled>Clear All</button>
          <div class="counter" id="counter">0 / 5 annotations</div>
        </div>

        <div class="stage-wrap">
          <div class="stage" id="stage" aria-label="Image annotation area">
            <div class="placeholder" id="placeholder">
              <strong>Begin with an image.</strong>
              Upload a comic panel, picture book page, illustration, or use the sample image. Then click 3–5 meaningful visual details.
            </div>
            <img id="analysisImage" alt="Student-selected image for visual analysis" />
          </div>
        </div>
      </div>

      <aside class="card side">
        <h2>Annotation Notes</h2>
        <p class="hint">For each pin, explain what you noticed and how that visual choice shapes meaning, mood, character, power, identity, conflict, or theme.</p>

        <div id="annotationList" class="annotation-list">
          <div class="empty-state">Your annotation notes will appear here after you click on the image.</div>
        </div>

        <div class="reflection">
          <label for="overallReflection">Overall interpretation</label>
          <textarea id="overallReflection" placeholder="In a few sentences, explain what your annotations reveal about the image or panel as a whole."></textarea>
        </div>

        <div class="export-box">
          <strong>To submit:</strong> Take a screenshot of your annotated image and copy/paste your notes into your assignment submission. Your work is stored temporarily in this browser only.
        </div>
      </aside>
    </section>
  </main>

  <script>
    const MAX_ANNOTATIONS = 5;

    const stage = document.getElementById("stage");
    const image = document.getElementById("analysisImage");
    const upload = document.getElementById("imageUpload");
    const placeholder = document.getElementById("placeholder");
    const annotationList = document.getElementById("annotationList");
    const counter = document.getElementById("counter");
    const undoButton = document.getElementById("undoButton");
    const clearButton = document.getElementById("clearButton");
    const sampleButton = document.getElementById("sampleButton");

    let annotations = [];
    let imageLoaded = false;

    const sampleSvg = `
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 620">
        <rect width="900" height="620" fill="#f3e4d4"/>
        <rect x="70" y="70" width="760" height="480" rx="28" fill="#fffaf4" stroke="#3d322d" stroke-width="8"/>
        <circle cx="240" cy="260" r="82" fill="#c96658"/>
        <path d="M174 342 C230 300 286 300 342 342" fill="none" stroke="#3d322d" stroke-width="10" stroke-linecap="round"/>
        <rect x="470" y="155" width="220" height="260" rx="18" fill="#304b5a"/>
        <circle cx="535" cy="235" r="26" fill="#f6d8a8"/>
        <circle cx="625" cy="235" r="26" fill="#f6d8a8"/>
        <path d="M520 318 C560 350 610 350 650 318" fill="none" stroke="#f6d8a8" stroke-width="9" stroke-linecap="round"/>
        <path d="M110 470 C220 430 310 510 420 470 S620 430 790 480" fill="none" stroke="#7b9b6f" stroke-width="16" stroke-linecap="round"/>
        <text x="450" y="92" text-anchor="middle" font-family="Georgia" font-size="34" fill="#3d322d">Sample Panel</text>
        <text x="450" y="520" text-anchor="middle" font-family="Arial" font-size="22" fill="#6f6760">Notice color, framing, expression, scale, line, and placement.</text>
      </svg>`;

    function updateUI() {
      counter.textContent = `${annotations.length} / ${MAX_ANNOTATIONS} annotations`;
      undoButton.disabled = annotations.length === 0;
      clearButton.disabled = annotations.length === 0;

      document.querySelectorAll(".pin").forEach(pin => pin.remove());

      annotations.forEach((annotation, index) => {
        const pin = document.createElement("div");
        pin.className = "pin";
        pin.textContent = index + 1;
        pin.style.left = `${annotation.xPercent}%`;
        pin.style.top = `${annotation.yPercent}%`;
        stage.appendChild(pin);
      });

      renderNotes();
      saveTemporaryWork();
    }

    function renderNotes() {
      annotationList.innerHTML = "";

      if (annotations.length === 0) {
        const empty = document.createElement("div");
        empty.className = "empty-state";
        empty.textContent = "Your annotation notes will appear here after you click on the image.";
        annotationList.appendChild(empty);
        return;
      }

      annotations.forEach((annotation, index) => {
        const item = document.createElement("div");
        item.className = "annotation";

        const label = document.createElement("label");
        label.innerHTML = `<div><span>${index + 1}</span> Annotation ${index + 1}</div><small>${Math.round(annotation.xPercent)}%, ${Math.round(annotation.yPercent)}%</small>`;

        const textarea = document.createElement("textarea");
        textarea.placeholder = "What visual detail did you notice? How does it shape meaning?";
        textarea.value = annotation.note;
        textarea.addEventListener("input", event => {
          annotations[index].note = event.target.value;
          saveTemporaryWork();
        });

        item.appendChild(label);
        item.appendChild(textarea);
        annotationList.appendChild(item);
      });
    }

    function loadImage(src) {
      image.src = src;
      image.onload = () => {
        image.style.display = "block";
        placeholder.style.display = "none";
        imageLoaded = true;
        annotations = [];
        updateUI();
      };
    }

    function saveTemporaryWork() {
      const data = {
        annotations,
        reflection: document.getElementById("overallReflection").value
      };
      sessionStorage.setItem("visualAnalysisStudio", JSON.stringify(data));
    }

    function restoreTemporaryWork() {
      const saved = sessionStorage.getItem("visualAnalysisStudio");
      if (!saved) return;

      try {
        const data = JSON.parse(saved);
        if (Array.isArray(data.annotations)) {
          annotations = data.annotations.slice(0, MAX_ANNOTATIONS);
        }
        if (typeof data.reflection === "string") {
          document.getElementById("overallReflection").value = data.reflection;
        }
      } catch (error) {
        console.warn("Could not restore temporary work.", error);
      }
    }

    upload.addEventListener("change", event => {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = readerEvent => loadImage(readerEvent.target.result);
      reader.readAsDataURL(file);
    });

    sampleButton.addEventListener("click", () => {
      const encoded = "data:image/svg+xml;charset=utf-8," + encodeURIComponent(sampleSvg);
      loadImage(encoded);
    });

    stage.addEventListener("click", event => {
      if (!imageLoaded) return;
      if (annotations.length >= MAX_ANNOTATIONS) {
        alert("You can add no more than 5 annotations.");
        return;
      }

      const rect = stage.getBoundingClientRect();
      const x = ((event.clientX - rect.left) / rect.width) * 100;
      const y = ((event.clientY - rect.top) / rect.height) * 100;

      annotations.push({
        xPercent: Math.min(100, Math.max(0, x)),
        yPercent: Math.min(100, Math.max(0, y)),
        note: ""
      });

      updateUI();
    });

    undoButton.addEventListener("click", () => {
      annotations.pop();
      updateUI();
    });

    clearButton.addEventListener("click", () => {
      const confirmed = confirm("Clear all annotations and notes?");
      if (!confirmed) return;
      annotations = [];
      updateUI();
    });

    document.getElementById("overallReflection").addEventListener("input", saveTemporaryWork);

    restoreTemporaryWork();
    updateUI();
  </script>
</body>
</html>
